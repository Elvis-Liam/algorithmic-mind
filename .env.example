# Algorithmic Mind — environment variables
# Copy to .env.local for local dev. Never commit a real .env file.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle; every
# other variable stays server-only.

# ---------------------------------------------------------------------------
# Supabase — Postgres, Auth, row level security
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudinary — media storage and transformation
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Resend — transactional and newsletter email
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_AUDIENCE_ID=

# ---------------------------------------------------------------------------
# Cloudflare — DNS, CDN, WAF, deployment target
# ---------------------------------------------------------------------------
# Used by CI to deploy via wrangler / opennextjs-cloudflare, not read by the
# app at runtime.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://algorithmicmind.com

# ---------------------------------------------------------------------------
# News discovery pipeline (Python, httpx + selectolax) — not read by Next.js
# ---------------------------------------------------------------------------
# Same Supabase project as above, service role, used server-side by the
# pipeline to write discovered items.
DISCOVERY_SUPABASE_URL=
DISCOVERY_SUPABASE_SERVICE_ROLE_KEY=
